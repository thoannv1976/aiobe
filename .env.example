# Postgres connection string
# Local dev: dùng Neon free tier (https://neon.tech) hoặc Postgres tự cài
# Production: Cloud SQL Postgres (kết nối qua Cloud SQL proxy hoặc IP công khai)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aiobe?schema=public"

# Anthropic API key — bật các chức năng AI (extract, suggest CLO, auto-map, sinh câu hỏi)
# Lấy tại https://console.anthropic.com → Settings → API Keys
# Bỏ trống nếu không dùng AI (các nút "✨ AI..." sẽ báo lỗi 503).
ANTHROPIC_API_KEY=""

# Optional: model AI mặc định
# claude-sonnet-4-6 (mặc định, chất lượng cao $3/$15 per Mtok)
# claude-haiku-4-5 (rẻ hơn $1/$5, nhanh hơn, độ chính xác thấp hơn cho task phức tạp)
AI_MODEL="claude-sonnet-4-6"
